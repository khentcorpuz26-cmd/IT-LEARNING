# Copy this file to .env.local (gitignored) and fill in real values.
# Firebase project settings (Firebase Console -> Project settings -> General).
# These are exposed to the browser; that's expected for Firebase web config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Signs our own session cookie after a Google sign-in is verified. Any long
# random string (e.g. `openssl rand -base64 32`); keep it secret and stable
# — rotating it logs everyone out. No Firebase service account key needed:
# ID tokens are verified against Google's public keys instead.
SESSION_SECRET=

# n8n webhook that receives {event, uid, email, name, timestamp} on each
# Google sign-in. Leave empty to disable tracking without breaking sign-in.
N8N_WEBHOOK_URL=
